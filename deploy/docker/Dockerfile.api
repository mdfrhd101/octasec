# OctaSec API — production image (Express + MongoDB driver).
# Build context: repo root.   docker build -f deploy/docker/Dockerfile.api .
FROM node:20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && pip3 install --break-system-packages --no-cache-dir sslyze==6.3.1 \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
WORKDIR /app

# deps first for layer caching; npm ci = lockfile-reproducible
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node server/ ./

USER node
EXPOSE 8610
CMD ["node", "src/index.js"]
