# OctaSec edge web image — builds both frontends, serves them with nginx.
# Replaces deploy/nginx.conf's dual role: static serving stays here; TLS +
# the octasec.ai server block stay on the HOST nginx (which proxies :8611).
# Build context: repo root.   docker build -f deploy/docker/Dockerfile.web .

# ---- marketing site (Next.js static export -> out/) ----
FROM node:20-bookworm-slim AS build-web
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ---- customer portal (Vite build -> dist/, same-origin API) ----
FROM node:20-bookworm-slim AS build-portal
WORKDIR /build/portal
COPY portal/package.json portal/package-lock.json ./
RUN npm ci
COPY portal/ ./
ENV VITE_API_URL=/api
RUN npm run build

# ---- runtime: unprivileged nginx (uid 101, port 8080) ----
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/docker/nginx.container.conf /etc/nginx/conf.d/default.conf
COPY deploy/octasec-headers.conf /etc/nginx/snippets/octasec-headers.conf
COPY --from=build-web /build/web/out /usr/share/nginx/html/web
COPY --from=build-portal /build/portal/dist /usr/share/nginx/html/portal
EXPOSE 8080
