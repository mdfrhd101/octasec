# Copy to .env and fill in. Never commit the real .env.
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/octasec
# Generate a real one: openssl rand -hex 32   (the boot check rejects placeholders)
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# ---- Email (forgot password, notifications) — docs/EMAIL_AND_PASSWORD_RESET.md ----
# Public base URL used in email links (no trailing slash)
APP_URL=http://127.0.0.1:3000
# Leave SMTP_HOST empty in local dev: emails are printed to the API console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OctaSec <no-reply@example.com>"
