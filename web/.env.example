# Build-time settings for the static site (copy to .env.production.local before "npm run build").

# API base. Default is same-origin "/api" (nginx in production and
# deploy/local-serve.mjs locally both proxy it). Only set this for `next dev`
# against a separately running API, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Canonical site origin — used in <link rel=canonical>, sitemap.xml and social-share cards
NEXT_PUBLIC_SITE_URL=https://octasec.ai

# Plausible analytics: leave empty to ship NO analytics tag; set to the site name registered in Plausible to enable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
